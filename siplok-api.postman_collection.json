    "name": "SIPLOK API Collection",
    "description": "Koleksi API Resmi Sistem Informasi Pelacakan Lokasi Dokumen Fisik Pertanahan — Kantor Pertanahan Kabupaten Banyumas, ATR/BPN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
