# ================================================================
# SIPLOK — Docker Compose Environment Variables
# Salin file ini menjadi .env sebelum menjalankan docker compose
# ================================================================

# Application Details
APP_NAME=SIPLOK
APP_ENV=local
APP_KEY=base64:siplokSecretKeyForLocalDevelopmentOnly123456=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=siplok_db
DB_USERNAME=siplok_user
DB_PASSWORD=siplok_pass123

# Port Mapping Host:Container
BACKEND_PORT=8000
FRONTEND_PORT=3000
PGSQL_PORT=5432
PGADMIN_PORT=5050

# pgAdmin Default Credentials
PGADMIN_DEFAULT_EMAIL=admin@siplok.lan
PGADMIN_DEFAULT_PASSWORD=admin123

# JWT Authentication (TTL: 480 mins / 8 jam kerja)
JWT_SECRET=d1fe5e81d89849d41d1a938c82b7c617b7b049d5843a88c75e2b34a41334c2ab
JWT_TTL=480
